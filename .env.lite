# ==================== 简化版配置 (本地开发) ====================

# 应用配置
APP_NAME=ChefMind
APP_ENV=development
DEBUG=true

# 数据库 (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./chefmind.db

# Milvus Lite (本地文件存储)
MILVUS_URI=./milvus_data/chefmind.db

# 文件存储 (本地目录)
STORAGE_PATH=./storage
UPLOAD_PATH=./storage/uploads
IMAGE_PATH=./storage/images

# LLM API 配置
# DeepSeek API (推荐，性价比高)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com

# 通义千问 API (备选)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# OpenAI API (用于多模态处理)
OPENAI_API_KEY=your_openai_api_key_here

# SiliconFlow API (推荐，支持多种模型)
SILICONFLOW_API_KEY=sk-stbgzwbunmivodvxzpnlzjpdorkimoiozdybiqdeuhilwvua
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_TEXT_MODEL=Qwen/Qwen3-8B
SILICONFLOW_VISION_MODEL=deepseek-ai/DeepSeek-OCR

# 模型配置
EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5
EMBEDDING_MODEL_DIMENSION=1024
RERANKER_MODEL_NAME=BAAI/bge-reranker-large

# RAG 配置
RETRIEVAL_TOP_K=30
RERANK_TOP_K=5
RELEVANCE_THRESHOLD=0.35
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP=0

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json
