# ==================== 应用配置 ====================
APP_NAME=ChefMind
APP_ENV=development
DEBUG=true

# ==================== 数据库配置 ====================
POSTGRES_USER=chefmind
POSTGRES_PASSWORD=chefmind123
POSTGRES_DB=chefmind
DATABASE_URL=postgresql+asyncpg://chefmind:chefmind123@postgres:5432/chefmind

# ==================== Redis 配置 ====================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==================== Milvus 配置 ====================
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=recipes

# ==================== MinIO 配置 ====================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=chefmind

# ==================== LLM API 配置 ====================
# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com

# 通义千问 API
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# OpenAI API (用于多模态处理)
OPENAI_API_KEY=your_openai_api_key_here

# ==================== 模型配置 ====================
# 嵌入模型
EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5
EMBEDDING_MODEL_DIMENSION=1024

# 重排序模型
RERANKER_MODEL_NAME=BAAI/bge-reranker-large

# ==================== RAG 配置 ====================
# 检索参数
RETRIEVAL_TOP_K=30
RERANK_TOP_K=5
RELEVANCE_THRESHOLD=0.35

# 分块参数
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP=0

# 缓存TTL(秒)
CACHE_TTL=3600

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FORMAT=json
